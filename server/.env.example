# ---- 服务 ----
PORT=8792
WEB_ORIGIN=http://localhost:5169

# ---- 汇率线上数据源（frankfurter / ECB，免 Key）----
FX_API_BASE=https://api.frankfurter.dev/v1

# ---- MySQL（本机 Oracle MySQL 8.0.42）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=finance_analytics

# ---- Cloudflare R2（账单附件存储，私有桶 + S3 兼容 API）----
# accountId 复用上方 CLOUDFLARE_ACCOUNT_ID；endpoint 自动推导为
# https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 预签名 URL 有效期（秒），可选，默认 3600
# R2_SIGNED_URL_TTL=3600

# ---- Stripe 收入同步（balance_transactions）----
STRIPE_SECRET_KEY=
# 可选，默认 https://api.stripe.com/v1
# STRIPE_API_BASE=

# ---- PayPal 收入同步（reporting/transactions）----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# live | sandbox，默认 live
# PAYPAL_MODE=live

# ---- GitHub 仓库统计（项目投入工时维度）----
# 私有仓库必填；公开仓库可留空（未认证限速 60 次/小时）
GITHUB_TOKEN=
# 可选，默认 https://api.github.com（GitHub Enterprise 可覆盖）
# GITHUB_API_BASE=https://api.github.com
# 是否开启每日自动同步（1 开 / 0 关），默认 1
# GITHUB_AUTO_SYNC=1
# 自动同步间隔（小时），默认 24
# GITHUB_SYNC_INTERVAL_HOURS=24
